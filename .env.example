# Email de tu cuenta de Brevo (el que usaste para registrarte)
BREVO_SMTP_USER=

# Clave SMTP de Brevo: Brevo → SMTP & API → SMTP → Generate a new SMTP Key
BREVO_SMTP_KEY=

# URL base de la aplicación (sin barra final)
# Desarrollo: http://localhost:3000
# Producción: https://tu-app.up.railway.app
BASE_URL=

# Clave secreta para proteger la creación de sorteos
# Solo quien conozca esta clave puede crear sorteos nuevos
ADMIN_SECRET=

# Puerto del servidor (Railway lo inyecta automáticamente)
PORT=3000
